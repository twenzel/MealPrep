POSTGRES_PASSWORD=hier-ein-langes-zufaelliges-datenbankpasswort-eintragen

# Optional: Wenn beide Werte gesetzt sind, ist nur dieser feste Zugang erlaubt.
# Das Passwort muss die ASP.NET-Core-Identity-Passwortrichtlinie erfüllen.
MEALPREP_USERNAME=mealprep
MEALPREP_PASSWORD=MealPrep-2026-sicher!

# Optional: AI-Rezeptbilder. Der Button erscheint nur bei true und gesetztem Key.
AI_RECIPE_IMAGES_ENABLED=false
AI_RECIPE_IMAGES_MODEL=gpt-image-1
AI_RECIPE_IMAGES_API_KEY=
AI_RECIPE_IMAGES_MEDIA_TYPE=image/png
